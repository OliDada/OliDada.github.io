
/* Upgrades (upgrades-ui.js): one list per branch, a sheet on phones */
#upgradesBtn{position:relative}#upgradesBtn.has-ready{border-color:var(--mint);color:var(--mint)}
.up-badge:not([hidden]){position:absolute;top:-4px;right:-4px;min-width:16px;height:16px;border-radius:8px;background:var(--mint);color:#152921;font:700 9px/16px 'DM Sans',sans-serif;font-style:normal;text-align:center;padding:0 4px}
#upgrades{width:min(760px,94vw);max-width:none;padding:28px 30px 24px;max-height:90vh;display:none;flex-direction:column}#upgrades[open]{display:flex}
#upgrades h2{margin:12px 0 6px}.up-summary{margin:0 0 14px}
.up-tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:12px;border-bottom:1px solid var(--line);flex-shrink:0;scrollbar-width:none}.up-tabs::-webkit-scrollbar{display:none}
.up-tabs button{flex-shrink:0;border-radius:16px;padding:7px 13px;font-size:11px;background:none;position:relative}
.up-tabs button[aria-selected=true]{background:var(--mint);color:#152921;border-color:var(--mint)}
.up-tabs button.has-ready::after{content:'';position:absolute;top:3px;right:3px;width:6px;height:6px;border-radius:50%;background:var(--mint);box-shadow:0 0 6px var(--mint)}
.up-tabs button.has-ready[aria-selected=true]::after{background:#152921;box-shadow:none}
.up-body{overflow-y:auto;padding-top:6px;min-height:0}
.up-blurb{margin:4px 0 12px!important;font-size:11px!important}
.up-node{border:1px solid var(--line);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:#0a171e80}
.up-node.ready{border-color:var(--mint);box-shadow:0 0 0 1px #c9f4cc33,0 0 24px #c9f4cc14}
.up-node.unlocked{opacity:.72}.up-node.locked{opacity:.55}
.up-node header{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.up-node h3{margin:0;font:500 17px 'Space Grotesk',sans-serif;color:var(--ink)}
.up-tag{font-size:9px;letter-spacing:1.5px;color:var(--muted);white-space:nowrap}.ready .up-tag,.unlocked .up-tag{color:var(--mint)}
.up-effect{margin:6px 0 0!important;color:#c9dad4!important}
.up-status{margin:2px 0 0!important;font-size:10px!important;color:#e8c98f!important}
.up-needs{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:8px}
.up-needs li{display:grid;grid-template-columns:18px 1fr auto;gap:8px;align-items:start;font-size:12px}
.up-check{width:14px;height:14px;border:1px solid #c9f4cc66;border-radius:3px;font-size:10px;line-height:13px;text-align:center;color:#152921;margin-top:1px}
.up-needs li.done .up-check{background:var(--mint);border-color:var(--mint)}
.up-needs li.done .up-label{color:var(--muted)}
.up-label small{display:block;font-size:10px;color:var(--muted);margin-top:3px;line-height:1.5}.up-label .up-hint{color:#9fc4b6}
.up-needs b{font-weight:500;font-size:11px;color:#c9dad4;white-space:nowrap}
.up-actions{margin-top:12px;display:flex;gap:8px}.up-actions button{padding:9px 14px;font-size:11px}
.up-actions button[aria-pressed=true]{border-color:var(--mint);color:var(--mint)}
#tracker{margin-top:14px;border-top:1px solid var(--line);padding-top:10px;display:grid;gap:4px;font-size:10px;color:#aabdba;line-height:1.4}
#tracker[hidden]{display:none}#tracker strong{color:var(--mint);font-weight:500;font-size:11px}
#worldTally{margin-top:6px!important;font-size:9px!important;letter-spacing:1.2px;color:var(--mint)!important}#worldTally[hidden]{display:none}
@media(max-width:700px),(pointer:coarse){
 #upgrades{width:100vw;max-width:100vw;max-height:88vh;margin:auto 0 0;border-radius:14px 14px 0 0;padding:20px 16px 14px;border-bottom:0}
 #upgrades h2{font-size:22px;margin:8px 0 4px}.up-summary{font-size:10px!important;line-height:1.5!important}
 .up-node{padding:12px}.up-needs li{font-size:11px}
 #tracker{margin-top:4px;border:0;padding:0;gap:2px;font-size:9px;max-width:56vw}#tracker span:nth-of-type(n+2){display:none}#tracker strong{font-size:10px}
 #worldTally{font-size:8px!important;letter-spacing:.6px}
}
