<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#080f19" />
        <meta
            name="description"
            content="A small expedition to an unfamiliar moon. Fly, land, and follow a signal."
        />
        <title>Elsewhere — Procedural Worlds</title>
        <link rel="stylesheet" href="style.css" />
        <!-- After a jump the page reloads into the new system: hide the start menu from
             the first frame instead of showing it until the game has loaded. -->
        <script>
            try {
                if (sessionStorage.getItem("elsewhere-arrival")) document.documentElement.classList.add("arriving");
            } catch {}
        </script>
        <style>
            .arriving #intro { display: none; }
        </style>
    </head>
    <body>
        <canvas
            id="world"
            aria-label="3D space exploration game. Keyboard controls are available in the flight manual."
        ></canvas>
        <div id="vignette"></div>
        <header>
            <a class="wordmark" href="../"
                >ELSEWHERE<span>AN OLID.IS EXPEDITION</span></a
            >
            <div class="top-right">
                <span class="prototype">SYSTEM TEST / 002</span
                ><button
                    id="galaxyBtn"
                    class="map-open"
                    title="Star map: nearby stars (G)"
                    aria-label="Open star map on nearby stars"
                >
                    ✦ <span>GALAXY</span></button
                ><button
                    id="mapBtn"
                    class="map-open"
                    title="System map (M)"
                    aria-label="Open system map"
                >
                    ◉ <span>MAP</span></button
                ><button
                    id="logBtn"
                    title="Expedition log"
                    aria-label="Open expedition log"
                    hidden
                >
                    ≡</button
                ><button
                    id="helpBtn"
                    title="Controls (H)"
                    aria-label="Open flight manual"
                >
                    ?</button
                ><button
                    id="soundBtn"
                    title="Toggle sound"
                    aria-label="Enable sound"
                >
                    ♪<span id="soundLabel">OFF</span>
                </button>
            </div>
        </header>
        <main id="hud" inert>
            <section class="location">
                <div class="eyebrow">
                    <span class="dot"></span
                    ><span id="modeLabel">ORBITAL FLIGHT</span>
                </div>
                <h1 id="worldName">VESPER</h1>
                <p id="worldType">A world waiting to be explored.</p>
            </section>
            <section class="mission">
                <div class="eyebrow">
                    EXPEDITION 01 <span id="stepCount">01 / 04</span>
                </div>
                <h2 id="objective">Follow the signal</h2>
                <p id="objectiveDetail">
                    Something is transmitting from the surface.
                </p>
                <div class="progress"><i id="progress"></i></div>
            </section>
            <div id="waypoint">
                <span class="diamond">◇</span
                ><strong id="waypointLabel">UNKNOWN SIGNAL</strong
                ><span id="waypointDistance"></span>
            </div>
            <div id="crosshair">+</div>
            <div id="toast" role="status" aria-live="polite"></div>
            <footer>
                <section class="telemetry">
                    <div>
                        <span id="altLabel">ALTITUDE</span
                        ><strong id="altitude">0 <small>m</small></strong>
                    </div>
                    <div>
                        <span id="speedLabel">VELOCITY</span
                        ><strong id="speed">0 <small>m/s</small></strong>
                    </div>
                    <div id="verticalReadout" class="status-readout">
                        <span>VERTICAL</span
                        ><strong id="verticalSpeed"
                            >+0.0 <small>m/s</small></strong
                        >
                    </div>
                    <div class="status-readout">
                        <span>VESSEL</span
                        ><strong id="vesselStatus">KESTREL</strong>
                    </div>
                </section>
                <section class="actions">
                    <button id="approachBtn" class="secondary">
                        ◎ Approach signal</button
                    ><button id="actionBtn" class="primary">
                        Descend to land <kbd>L</kbd>
                    </button>
                </section>
                <div class="control-hint" id="controlHint">
                    <kbd>W S</kbd> thrust <kbd>A D</kbd> steer
                    <kbd>R F</kbd> altitude <kbd>SHIFT</kbd> boost
                    <span>Drag to look · H controls</span>
                </div>
            </footer>
            <div id="touchControls" aria-label="Touch movement controls">
                <div id="joystick" class="joystick" aria-label="Movement stick: drag to fly or walk"><i></i></div>
                <div class="touch-alt">
                    <button data-key="KeyR" aria-label="Ascend">＋</button
                    ><button data-key="KeyF" aria-label="Descend">−</button
                    ><button data-key="Space" class="jump-btn" aria-label="Jump">⤒</button>
                </div>
            </div>
        </main>
        <div id="intro" class="overlay">
            <section class="intro-card">
                <div class="eyebrow">A SMALL STEP INTO THE UNKNOWN</div>
                <h2>Somewhere,<br />something<br />is listening.</h2>
                <p id="introDescription">
                    Unfamiliar worlds. Unfamiliar signals. Choose your own
                    course.
                </p>
                <button id="startBtn" class="primary">
                    Begin expedition <span>↗</span>
                </button>
                <div class="intro-note">
                    One ship. A new star system for every seed.<br />Desktop
                    keyboard recommended · touch controls included
                </div>
            </section>
            <div class="coordinates" id="systemCoordinates">
                PROCEDURAL SOLAR SYSTEM
            </div>
        </div>
        <dialog id="help">
            <button class="close" id="closeHelp" aria-label="Close manual">
                ×
            </button>
            <div class="eyebrow">KESTREL / PILOT HANDBOOK</div>
            <h2>A little flight manual.</h2>
            <h3>Between worlds</h3>
            <dl>
                <dt>M</dt>
                <dd>Star map, opened on your system</dd>
                <dt>T</dt>
                <dd>Engage / disengage cruise to the selected world</dd>
                <dt>G</dt>
                <dd>Star map, opened on nearby stars</dd>
            </dl>
            <p>
                The star map zooms from the whole galaxy down to a single
                system's moons. To jump between stars, climb into free space,
                select a star inside your drive range and press Jump. Your
                position in the galaxy is saved; the URL links to the star you
                are at.
            </p>
            <p>
                Climb above 600 m to enter free spaceflight. Use W/S, A/D, ↑/↓
                and R/F to fly between planets; Shift boosts your spaceflight
                speed. Cruise follows a short assisted route. Every solid world
                supports landing and walking. The star is not landable.
            </p>
            <h3>At the helm</h3>
            <dl>
                <dt>W / S</dt>
                <dd>Forward / reverse thrust</dd>
                <dt>A / D</dt>
                <dd>Turn left / right</dd>
                <dt>R / F</dt>
                <dd>Lift / descend with vertical thrusters</dd>
                <dt>↑ / ↓</dt>
                <dd>Pitch up / down while flying forward</dd>
                <dt>Shift</dt>
                <dd>Boost</dd>
                <dt>X</dt>
                <dd>Brake forward and vertical motion</dd>
                <dt>Mouse</dt>
                <dd>Click the view, then move the mouse to look around (Esc frees the cursor). On touch, drag.</dd>
                <dt>L</dt>
                <dd>Land / take off</dd>
            </dl>
            <h3>On the surface</h3>
            <dl>
                <dt>W A S D</dt>
                <dd>Walk / strafe</dd>
                <dt>Mouse / ← →</dt>
                <dd>Look around</dd>
                <dt>Space</dt>
                <dd>Jump (higher on low-gravity worlds)</dd>
                <dt>E</dt>
                <dd>Investigate / board ship</dd>
                <dt>Walk near</dt>
                <dd>Catalogue a plant species</dd>
                <dt>Shift</dt>
                <dd>Walk faster</dd>
            </dl>
            <p>
                Land below 32 m and under 18 m/s forward speed. Landing deploys
                the gear and gently settles the ship; takeoff charges the lift
                engines and rises clear of the ground. “Approach signal” takes
                you to a safe landing area. Manual input cancels the approach.
                Your discovery is saved on this browser; your flight position
                resets on reload.
            </p>
            <button id="resetBtn" class="secondary">Restart expedition</button>
        </dialog>
        <dialog id="discovery">
            <div class="eyebrow" id="discoveryEyebrow">FIELD NOTE</div>
            <h2 id="discoveryTitle">It was waiting.</h2>
            <p id="discoveryText"></p>
            <blockquote id="discoveryQuote"></blockquote>
            <p class="discovery-note">
                Signal recorded in your expedition log. Return to Kestrel and
                take to the sky.
            </p>
            <button id="closeDiscovery" class="primary">
                Continue expedition ↗
            </button>
        </dialog>
        <div id="transit" hidden>
            <div class="eyebrow" id="transitTitle">CRUISE ENGAGED</div>
            <strong id="transitPercent">0%</strong>
            <div class="progress"><i id="transitProgress"></i></div>
            <button id="cancelTransit">Disengage <kbd>T</kbd></button>
        </div>

        <dialog id="starMap" aria-label="Star map">
            <canvas
                id="starCanvas"
                aria-label="Star map from the whole galaxy down to single systems. Drag to pan, scroll or pinch to zoom, tap to select, double-tap a star to open its system. Everything on the map is also listed in the side panel."
            ></canvas>
            <div class="map-head">
                <div class="eyebrow">KESTREL / NAVIGATION</div>
                <h2 id="mapTitle">THE GALAXY</h2>
                <p id="mapSubtitle"></p>
            </div>
            <div class="map-tools">
                <button id="mapViewGalaxy">✦ Galaxy</button
                ><button id="mapViewLocal">◎ Nearby</button
                ><button id="mapViewSystem">◉ This system</button
                ><button id="mapZoomOut" aria-label="Zoom out">−</button
                ><button id="mapZoomIn" aria-label="Zoom in">+</button
                ><button
                    id="closeStarMap"
                    class="map-close"
                    aria-label="Close map"
                >
                    ×
                </button>
            </div>
            <aside id="mapPanel">
                <button
                    id="mapPanelToggle"
                    class="panel-toggle"
                    aria-label="Show or hide details"
                >
                    <span></span>
                </button>
                <div class="panel-body">
                    <div class="destination">
                        <div class="eyebrow" id="mapKicker"></div>
                        <h3 id="mapName"></h3>
                        <p id="mapDescription"></p>
                        <small id="mapFacts"></small
                        ><button id="mapAction" class="primary"></button>
                        <button id="mapCourse" class="secondary map-course" hidden></button>
                        <p class="map-note" id="mapNote"></p>
                    </div>
                    <div class="eyebrow list-heading" id="mapWorldsHeading">
                        WORLDS
                    </div>
                    <div id="mapWorlds" class="map-list"></div>
                    <div class="eyebrow list-heading">IN JUMP RANGE</div>
                    <div id="mapJumps" class="map-list"></div>
                    <div class="eyebrow list-heading" id="mapRadioHeading">RADIO SIGNALS</div>
                    <div id="mapRadio" class="map-list"></div>
                    <details class="offchart">
                        <summary>Off-chart systems (seed)</summary>
                        <form id="seedForm">
                            <label for="seedInput">OFF-CHART SYSTEM SEED</label>
                            <div>
                                <input
                                    id="seedInput"
                                    type="number"
                                    min="0"
                                    max="4294967295"
                                    required
                                /><button type="submit">Generate</button>
                            </div>
                            <button type="button" id="randomSystem">
                                Discover a new system ↗
                            </button>
                        </form>
                        <p class="map-note">
                            Same seed, same worlds. Seeds open systems outside
                            the star map; jumping from one returns you to your
                            last charted star. Generating a system restarts your
                            flight. Discoveries are saved separately for each
                            seed. Orbital distances are compressed for
                            exploration.
                        </p>
                    </details>
                </div>
            </aside>
            <div class="map-scale" id="mapScale"></div>
        </dialog>
        <div id="error" hidden>
            <h2>Unable to start the expedition</h2>
            <p id="errorMessage"></p>
            <button onclick="location.reload()">Try again</button>
        </div>
        <script type="module" src="game.js"></script>
    </body>
</html>
