};
for (const [id, u] of Object.entries(UPGRADES)) { u.id = id; u.after ||= []; }

// --- Effects the game reads ----------------------------------------------------------
export const jumpRange = (unlocked) => unlocked.has('jumpDrive3') ? 24 : unlocked.has('jumpDrive2') ? 16 : JUMP_RANGE;
export const suitDamageScale = (unlocked) => unlocked.has('suitPlating') ? 0.7 : 1;
export const suitRecoveryScale = (unlocked) => unlocked.has('suitPlating') ? 2 : 1;
export const heatScale = (unlocked) => unlocked.has('heatPlating') ? 0.6 : 1;

// --- Matching ------------------------------------------------------------------------
const get = (e, path) => path === 'world' ? (e.world ? `${e.seed}:${e.bodyId}` : undefined)
  : path.split('.').reduce((v, k) => (v == null ? undefined : v[k]), e);
function matchValue(v, c) {
  if (Array.isArray(c)) return c.includes(v);
  if (c && typeof c === 'object') {
    if ('atLeast' in c) return tierAtLeast(v, c.atLeast);
    if ('min' in c || 'max' in c) return typeof v === 'number' && (c.min == null || v >= c.min) && (c.max == null || v <= c.max);
    return v != null && Object.entries(c).every(([k, x]) => matchValue(v[k], x));
  }
  return v === c;
}
export function matches(e, q) {
  if (q.anyOf) return q.anyOf.some((x) => matches(e, x));
  const kind = q.kind ?? 'any';
  if (kind === 'any' ? !DOCUMENTED.includes(e.kind) : Array.isArray(kind) ? !kind.includes(e.kind) : kind !== e.kind) return false;
  if (q.world && !(e.world && Object.entries(q.world).every(([k, c]) => matchValue(e.world[k], c)))) return false;
  if (q.traits && !Object.entries(q.traits).every(([k, c]) => matchValue(e.traits?.[k], c))) return false;
  return true;
}
const distinct = (list, path) => new Set(list.map((e) => get(e, path)).filter((v) => v != null)).size;

const SPREAD_WORDS = { world: 'worlds', 'world.biome': 'biomes', 'traits.plan': 'body plans', 'world.biochemistry': 'chemistries', 'world.clouds': 'cloud types' };
function measure(need, list) {
  const count = need.count ?? 1;
  const have = need.distinct ? distinct(list, need.distinct) : list.length;
  const spread = Object.entries(need.spread || {}).map(([path, n]) => ({ label: SPREAD_WORDS[path] || path, have: Math.min(distinct(list, path), n), need: n }));
  return { have: Math.min(have, count), count, spread, done: have >= count && spread.every((s) => s.have >= s.need) };
}
const score = (m) => (m.have / m.count + m.spread.reduce((a, s) => a + s.have / s.need, 0)) / (1 + m.spread.length);
const worldKey = (e) => `${e.seed}:${e.bodyId}`;
function byWorld(list) {
  const groups = new Map();
  for (const e of list) { const k = worldKey(e); if (!groups.has(k)) groups.set(k, []); groups.get(k).push(e); }
  return [...groups.values()];
}

// What has been recorded on one world: { flora, fauna, formation } counts.
export function recordedOn(entries, seed, bodyId) {
  const c = { flora: 0, fauna: 0, formation: 0 };
  for (const e of entries) if (e.seed === String(seed) && e.bodyId === bodyId && e.kind in c) c[e.kind]++;
  return c;
}
// Worlds where every plant, animal and formation that is there has been recorded.
export function completedWorlds(entries) {
  const counts = new Map();
  for (const e of entries) if (['flora', 'fauna', 'formation'].includes(e.kind)) {
    const k = worldKey(e), c = counts.get(k) || { flora: 0, fauna: 0, formation: 0 };
    c[e.kind]++; counts.set(k, c);
  }
  return entries.filter((e) => {
    if (e.kind !== 'world' || !e.traits?.totals) return false;
    const t = e.traits.totals, c = counts.get(worldKey(e)) || { flora: 0, fauna: 0, formation: 0 };
    return t.flora + t.fauna + t.formations > 0 && c.flora >= t.flora && c.fauna >= t.fauna && c.formation >= t.formations;
  });
}

function needProgress(need, entries, unlocked) {
  switch (need.special) {
    case 'upgrades': {
      const n = [...unlocked].filter((id) => UPGRADES[id] && !UPGRADES[id].ship).length;
      return measure(need, Array(n).fill(null));
    }
    case 'complete': return measure(need, completedWorlds(entries));
    case 'hunt': {
      const fauna = entries.filter((e) => e.kind === 'fauna');
      const seen = new Set(fauna.map((e) => `${worldKey(e)}:${e.id}`));
      return measure(need, fauna.filter((e) => e.traits.diet === 'carnivore' && e.traits.prey?.some((id) => seen.has(`${worldKey(e)}:${id}`))));
    }
    case 'relationship': return { ...measure(need, []), notYet: 'Contact' }; // relationships arrive with Contact (roadmap phase 4)
  }
  const list = entries.filter((e) => matches(e, need));
  if (!need.sameWorld) return measure(need, list);
  return byWorld(list).map((g) => measure(need, g)).reduce((best, m) => (score(m) > score(best) ? m : best), measure(need, []));
}

// progress(codex.entries, codex.unlocked) -> { [id]: { id, upgrade, unlocked, available, ready, needs: [...] } }
//   available: every prerequisite is unlocked · ready: available and every need is met
//   needs[i]: { label, have, count, spread: [{ label, have, need }], done, notYet? }
export function progress(entries, unlocked = new Set()) {
  const out = {};
  for (const u of Object.values(UPGRADES)) {
    const needs = u.needs.map((n) => ({ label: n.label, ...needProgress(n, entries, unlocked) }));
    const available = u.after.every((id) => unlocked.has(id));
    out[u.id] = { id: u.id, upgrade: u, unlocked: unlocked.has(u.id), available, ready: !unlocked.has(u.id) && available && needs.every((n) => n.done), needs };
  }
  return out;
}

// What a new entry moved forward: compare progress before and after adding it.
// -> [{ id, name, label, have, count, spread, ready }] for upgrades not yet unlocked.
export function advanced(before, after) {
  const out = [];
  for (const [id, a] of Object.entries(after)) {
    const b = before[id];
    if (a.unlocked || !b) continue;
    a.needs.forEach((n, i) => {
      const o = b.needs[i];
      if (n.have > o.have || n.spread.some((s, j) => s.have > o.spread[j].have))
        out.push({ id, name: a.upgrade.name, label: n.label, have: n.have, count: n.count, spread: n.spread, ready: a.ready && !b.ready });
    });
  }
  return out;
}

// --- Hints: where to look, generated from the requirement ------------------------------
const PLAN_HINTS = {
  quadruped: 'worlds with complex life', biped: 'complex-life worlds, more often with low gravity',
  hexapod: 'drier worlds with life', arachnid: 'drier worlds with life', serpent: 'drier worlds with life', slug: 'wet worlds with life',
  flyer: 'complex-life worlds with thick enough air', floater: 'complex-life worlds with thick air or low gravity',
  radial: 'worlds with complex life', roller: 'dry complex-life worlds with gravity under 1.6 g',
};
const FORM_HINTS = {
  tree: 'warm, wet worlds with complex life', conifer: 'cool worlds with complex life', palm: 'hot, wet coasts', shrub: 'most living worlds',
  grass: 'temperate living worlds', succulent: 'hot, dry worlds', fungus: 'dim, wet worlds (red dwarfs)', stalk: 'low-gravity living worlds',
  mat: 'microbial worlds', mound: 'microbial worlds',
};
const FORMATION_HINTS = {
  columns: 'Volcanic worlds', obsidian: 'Volcanic worlds', fumaroles: 'volcanic worlds with air', hoodoos: 'Desert worlds', arch: 'Desert worlds',
  penitentes: 'icy worlds with thin air', pingo: 'Frozen worlds, and icy moons with hidden oceans', cryovolcano: 'icy, volcanically active moons',
  crystals: 'Amethyst worlds and silicon worlds', terraces: 'Toxic worlds and wet volcanic shores', chimneys: 'Toxic worlds and sulfur-life worlds',
  karst: 'temperate worlds with seas', seastacks: 'coasts of worlds with seas', boulders: 'airless worlds', strata: 'almost any world',
  geode: 'anywhere, but rare', meteorite: 'anywhere, but rare (more often airless worlds)',
};
const CHEM_HINTS = {
  methane: 'very cold worlds under an orange haze (violet ring on the map)', ammonia: 'cold worlds with thick air (violet ring on the map)',
  sulfur: 'hot volcanic worlds (violet ring on the map)', silicon: 'very hot worlds (violet ring on the map)', carbon: 'worlds with water-based life',
};
const KIND_HINTS = {
  flora: 'worlds with life (green rings on the map)', fauna: 'worlds with simple or complex life (bold green rings on the map)',
  formation: 'every world with a surface', settlement: 'worlds with intelligent life: look for SIGNALS on the map',
  'field-note': 'the signal at each landing site', world: 'anywhere you fly to',
};
const asList = (v) => (Array.isArray(v) ? v : [v]);
const or = (xs) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs.at(-1)}`);
function hintFor(q) {
  const out = [], w = q.world || {}, t = q.traits || {};
  if (w.giant) out.push('gas and ice giants');
  if (w.biochemistry) out.push(...asList(w.biochemistry).map((c) => CHEM_HINTS[c]));
  if (w.biome) out.push(`${or(asList(w.biome))} worlds`);
  if (w.waterState === 'liquid') out.push('Oceanic and Verdant worlds');
  if (w.gravity?.min) out.push(`worlds above ${w.gravity.min} g`);
  if (t.plan) out.push(...asList(t.plan).map((p) => PLAN_HINTS[p]));
  if (t.form) out.push(...asList(t.form).map((f) => FORM_HINTS[f]));
  if (t.formation) out.push(...asList(t.formation).map((f) => FORMATION_HINTS[f]));
  if (t.habitat?.shore) out.push('coasts of worlds with seas');
  if (t.glow) out.push('dim worlds around red dwarfs, where many species glow');
  if (t.activity === 'nocturnal') out.push('worlds with day and night, after dark');
  if (t.stalksYou) out.push('complex-life worlds with big hunters (about 1 in 8); keep your distance');
  if (t.tier) out.push('worlds with intelligent life: SIGNALS on the map, gold radio marks');
  if (!out.length) out.push(...asList(q.kind ?? 'any').map((k) => KIND_HINTS[k]));
  return out.filter(Boolean);
}
export function hint(need) {
  if (need.special === 'hunt') return "Complex-life worlds: an animal's description says what it hunts.";
  if (need.special === 'complete') return 'Small worlds with few species are quickest. The HUD counts what is left on the world you are on.';
  if (need.special === 'upgrades') return 'Any upgrade counts.';
  if (need.special === 'relationship') return 'Arrives with Contact (not in the game yet).';
  if (need.kind === 'any' && !need.world && !need.traits) return 'Anything you record counts: plants, animals, formations, settlements.';
  if (need.kind === 'signal') return 'Open the star map: planet-shapers and spacefarers broadcast far beyond jump range.';
  const found = [...new Set(need.anyOf ? need.anyOf.flatMap(hintFor) : hintFor(need))];
  return found.length ? `Found on: ${or(found)}` : null;
}
