// The upgrade tree (PROGRESSION.md): what you document becomes the knowledge your
// ship is built from. Plain data plus the code that checks it against the codex
// (codex.mjs), so it can be tested with node --test and read by the game and the UI.
//
// A requirement ("need") is a question about traits, never a named species:
//   { label, count = 1,
//     kind:     'flora' | 'fauna' | 'formation' | 'settlement' | 'field-note' | 'world' | 'signal' | [...] | 'any',
//     world:    { biome: [...], waterState: 'liquid', giant: true, gravity: { min: 1.3 }, … },
//     traits:   { plan: [...], glow: { min: .45 }, habitat: { shore: true }, tier: { atLeast: 'city builders' }, … },
//     anyOf:    [query, query]      matches if any query matches (instead of kind/world/traits)
//     distinct: 'traits.formation'  count different values instead of entries
//     spread:   { 'world.biome': 3 } and the matches must cover this many different values
//     sameWorld: true               all on one world
//     special:  'hunt' | 'complete' | 'upgrades' | 'relationship' }
// A value in a query is a name, a list of names (any of them), { min, max } or { atLeast: tier }.
// Hints ("Found on: …") are generated from the query, never written per upgrade.
import { DOCUMENTED } from './codex.mjs';
import { tierAtLeast } from './civilizations.mjs';
import { JUMP_RANGE } from './galaxy.mjs';

export const BRANCHES = [
  { id: 'starter', name: 'First steps', blurb: 'How upgrades work: scan a few things on the world you land on, then visit a second.' },
  { id: 'environment', name: 'Environment', blurb: 'New places to set down. Nothing you can land on today is ever locked.' },
  { id: 'propulsion', name: 'Propulsion', blurb: 'How far you can go.' },
  { id: 'scanner', name: 'Scanner', blurb: 'How you find things.' },
  { id: 'tools', name: 'Tools', blurb: 'New ways to explore a world.' },
  { id: 'contact', name: 'Contact', blurb: 'Knowing minds. These unlock understanding, not abilities.' },
  { id: 'ship', name: 'Ship class', blurb: 'The big milestones: a new hull with room for more.' },
];

// status: what unlocking does in the game today.
//   'live'    the effect works
//   'partial' part of the effect works (`built` says which part)
//   'planned' the effect is still a to-do item (PROGRESSION.md roadmap)
