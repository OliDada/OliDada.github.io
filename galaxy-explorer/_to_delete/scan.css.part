
/* Scanning (scanning.js, scan-ui.js): the ◎ marker and the card */
.scan-marker{position:fixed;left:0;top:0;z-index:2;pointer-events:none;opacity:0;transition:opacity .2s;display:flex;flex-direction:column;align-items:center;margin-left:-60px;width:120px;margin-top:-26px}
.scan-marker.visible{opacity:1}
.scan-ring{width:52px;height:52px;border-radius:50%;border:1.5px solid #c9f4ccaa;box-shadow:0 0 14px #c9f4cc44,inset 0 0 10px #c9f4cc22;position:relative;animation:scanPulse 1.6s ease-in-out infinite}
.scan-ring::after{content:'';position:absolute;inset:-1.5px;border-radius:50%;background:conic-gradient(var(--mint) var(--p,0%),transparent 0);-webkit-mask:radial-gradient(circle,transparent 22px,#000 23px);mask:radial-gradient(circle,transparent 22px,#000 23px)}
.scan-ring::before{content:'';position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px;border-radius:50%;background:var(--mint);box-shadow:0 0 8px var(--mint)}
.scanning .scan-ring{animation:none;border-color:#c9f4cc55}
.scan-marker.done .scan-ring{animation:scanDone .6s ease-out}
.scan-label{margin-top:8px;font-size:9px;font-weight:600;letter-spacing:2px;color:#e3f3cd;text-shadow:0 1px 6px #000;white-space:nowrap}
.scan-marker kbd{margin:5px 0 0;color:#152921;background:var(--mint);border:0;font-weight:700;letter-spacing:1px;font-size:9px;padding:3px 6px}
.scanning kbd{background:none;color:var(--mint)}
@keyframes scanPulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.08);opacity:1}}
@keyframes scanDone{0%{transform:scale(1);box-shadow:0 0 0 0 #c9f4cc}100%{transform:scale(1.9);opacity:0;box-shadow:0 0 0 18px #c9f4cc00}}
.scan-card{position:absolute;left:36px;bottom:150px;width:340px;max-height:calc(100vh - 340px);overflow:auto;z-index:2;pointer-events:auto;background:#0b1a21ee;backdrop-filter:blur(18px);border:1px solid #c9f4cc40;border-radius:10px;padding:18px 20px 16px;box-shadow:0 20px 60px #0008;opacity:0;transform:translateY(10px);transition:opacity .25s,transform .25s}
.scan-card.in{opacity:1;transform:none}.scan-card[hidden]{display:none}
.scan-close{position:absolute;top:8px;right:8px;border:0;background:none;font-size:20px;line-height:1;padding:4px 8px;color:var(--muted)}
.scan-eyebrow{font-size:9px;font-weight:600;letter-spacing:2px;color:var(--mint);padding-right:24px}
.scan-card h3{font:500 24px 'Space Grotesk',sans-serif;letter-spacing:-.5px;margin:8px 0 0;color:var(--ink)}
.scan-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}
.scan-tags span{font-size:9px;letter-spacing:1px;text-transform:uppercase;border:1px solid #c9f4cc55;color:var(--mint);border-radius:10px;padding:2px 8px}
.scan-tags .tone-warn{border-color:#ff9a7a88;color:#ffb39a}.scan-tags .tone-gold{border-color:#e8c98f88;color:#f0d49a}
.scan-lede{font-size:13px;line-height:1.55;color:#c9dad4;margin:10px 0 12px}
.scan-card dl{display:grid;grid-template-columns:80px 1fr;gap:6px 12px;margin:0;font-size:11px;border-top:1px solid var(--line);padding-top:12px}
.scan-card dt{color:var(--muted);letter-spacing:.5px}.scan-card dd{margin:0;color:#dce9e4}
.scan-foot{margin-top:14px;padding-top:10px;border-top:1px solid var(--line);font-size:11px;color:#aabdba}
.scan-foot::before{content:'◆ ';color:var(--mint)}
.scan-foot.ready{color:var(--mint);font-weight:600}
/* The next-upgrade guide (upgrades-ui.js) in place of the old expedition objective */
#guide h2{margin:12px 0 6px}
#guide.ready{border-top-color:var(--mint)}#guide.ready h2{color:var(--mint)}
.guide-needs{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:6px}
.guide-needs li{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:#c9dad4;line-height:1.4}
.guide-needs li span::before{content:'○ ';color:#c9f4cc99}.guide-needs li.done{color:var(--muted)}.guide-needs li.done span::before{content:'● ';color:var(--mint)}
.guide-needs b{font-weight:500;white-space:nowrap;color:var(--mint)}
.guide-tip{display:block;margin-top:8px;font-size:10px;line-height:1.5;color:#9fc4b6}
.guide-btn{margin-top:14px;padding:10px 14px;font-size:12px}
@media(pointer:coarse),(max-width:700px){
 .scan-card{left:12px;right:12px;width:auto;top:132px;bottom:auto;max-height:calc(100vh - 330px);padding:14px 16px 12px}
 .scan-card h3{font-size:19px}.scan-lede{font-size:12px;margin:8px 0 10px}.scan-card dl{grid-template-columns:70px 1fr;font-size:10px;gap:4px 10px}
 #guide .guide-needs{display:grid;margin-top:4px}#guide .guide-needs li{font-size:9px}#guide .guide-needs li.done,#guide .guide-needs li:not(.done)~li{display:none}
 #guide .guide-tip{display:none}#guide .guide-btn{margin-top:6px;padding:7px 10px;font-size:10px}
}
